{
	// Tests and tool configs, run by Node (Vitest, Playwright, Vite). The e2e tests also run code in the page.
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"types": ["node", "vite/client"],
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
	},
	"include": ["tests", "src/globals.d.ts", "vite.config.ts", "playwright.config.ts"]
}
