{
  "name": "thrust",
  "version": "0.1.0",
  "description": "Thrust game",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --maxWorkers=4",
    "package": "vite build && tar -czf thrust-$npm_package_version.tgz -C dist .",
    "deploy": "vite build && ./scripts/deploy.sh",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "maps": "./scripts/export-maps.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cambell-prince/thrust.git"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  }
}
